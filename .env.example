# Copy to .env and fill in. NEVER commit .env or store secrets anywhere else.

# --- Market data ---
# TRADINGVIEW_USERNAME=
# TRADINGVIEW_PASSWORD=
# TV_WEBHOOK_SECRET=        # shared secret to validate TradingView alert webhooks

# --- Research / news ---
# NEWS_API_KEY=

# --- Broker (paper trading by default) ---
# BROKER=paper
# IBKR_ACCOUNT_ID=

# --- Delivery ---
# GOOGLE_SHEETS_ID=
# NOTION_DATABASE_ID=
